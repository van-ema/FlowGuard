digraph flowguard_violation {
  graph [label="Flowguard SecretToNetwork Violation", labelloc=t, fontsize=20, rankdir=LR, bgcolor="#fffaf0"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#2f2a24", penwidth=1.5];
  edge [fontname="Helvetica", fontsize=11, color="#6b4f2a", fontcolor="#4f3b1f", penwidth=2];

  n0 [label="SECRET file\nfile:/home/user/.ssh/id_rsa", fillcolor="#ffe0d6"];
  n1 [label="Process\nproc:22@10030", fillcolor="#e8f2ff"];
  n2 [label="Pipe\npipe:1000", fillcolor="#fff1ba"];
  n3 [label="Process\nproc:23@10040", fillcolor="#e8f2ff"];
  n4 [label="Network endpoint\nendpoint:192.168.65.254:18000", fillcolor="#ffd6e7"];

  n0 -> n1 [label="READ", color="#6b4f2a", fontcolor="#6b4f2a"];
  n1 -> n2 [label="WRITE", color="#6b4f2a", fontcolor="#6b4f2a"];
  n2 -> n3 [label="READ", color="#6b4f2a", fontcolor="#6b4f2a"];
  n3 -> n4 [label="SEND\nBLOCK SecretToNetwork", color="#b42318", fontcolor="#b42318"];
}
